[app]
title = Echoes of the Fifty Six Worlds
package.name = echoesfiftysix
package.domain = com.phantomnightmare
source.dir = .
source.include_exts = py,png,json
source.exclude_dirs = .git,.venv,venv,build,dist,__pycache__,assets/chapter_music
version = 1.0.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions =
android.api = 35
android.minapi = 24
android.archs = arm64-v8a
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
